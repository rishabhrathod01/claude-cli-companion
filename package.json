{
  "name": "claude-cli-companion",
  "publisher": "rishabh-rathod",
  "displayName": "Claude CLI Companion",
  "description": "Send @file:lines references to Claude Code from the editor with a single keybind",
  "version": "0.1.0",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "keywords": [
    "claude",
    "claude code",
    "ai",
    "context",
    "diff",
    "terminal",
    "anthropic"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/rishabhrathod01/claude-cli-companion"
  },
  "bugs": {
    "url": "https://github.com/rishabhrathod01/claude-cli-companion/issues"
  },
  "homepage": "https://github.com/rishabhrathod01/claude-cli-companion#readme",
  "galleryBanner": {
    "color": "#CC6633",
    "theme": "dark"
  },
  "license": "MIT",
  "icon": "icon.png",
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "claude-cli-companion.sendContext",
        "title": "Send File Context to Claude"
      },
      {
        "command": "claude-cli-companion.openTerminalAndSendContext",
        "title": "Send File Context Label to Claude"
      },
      {
        "command": "claude-cli-companion.sendFromExplorer",
        "title": "Send to Claude"
      },
      {
        "command": "claudeDiff.acceptChanges",
        "title": "Accept Claude Changes",
        "icon": "$(check)"
      },
      {
        "command": "claudeDiff.rejectChanges",
        "title": "Reject Claude Changes",
        "icon": "$(discard)"
      },
      {
        "command": "claudeDiff.acceptAll",
        "title": "Claude Diff: Accept All Pending Changes"
      },
      {
        "command": "claudeDiff.rejectAll",
        "title": "Claude Diff: Reject All Pending Changes"
      },
      {
        "command": "claudeDiff.showQueue",
        "title": "Claude Diff: Show Pending Review Queue"
      },
      {
        "command": "claudeDiff.installHooks",
        "title": "Claude Diff: Install Claude Code Hooks"
      },
      {
        "command": "claudePlan.build",
        "title": "Build Plan",
        "icon": "$(run-all)"
      },
      {
        "command": "claudePlan.discard",
        "title": "Discard Plan",
        "icon": "$(trash)"
      },
      {
        "command": "claudePlan.openLatest",
        "title": "Claude: Open Latest Plan"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "claude-cli-companion.sendFromExplorer",
          "group": "navigation@99"
        }
      ],
      "editor/title": [
        {
          "command": "claudeDiff.acceptChanges",
          "when": "claudeDiff.isDiffOpen",
          "group": "navigation@1"
        },
        {
          "command": "claudeDiff.rejectChanges",
          "when": "claudeDiff.isDiffOpen",
          "group": "navigation@2"
        },
        {
          "command": "claudePlan.build",
          "when": "resourcePath =~ /\\.claude\\/plans\\/[^\\/]*\\.md$/",
          "group": "navigation@1"
        },
        {
          "command": "claudePlan.discard",
          "when": "resourcePath =~ /\\.claude\\/plans\\/[^\\/]*\\.md$/",
          "group": "navigation@2"
        }
      ]
    },
    "configuration": {
      "title": "Claude CLI Companion",
      "properties": {
        "claudeDiff.port": {
          "type": "number",
          "default": 7878,
          "description": "Preferred port for this window's local hook server. Every window runs its own server, so when this port is taken an ephemeral one is used instead — the Claude Code hook finds each window through the instance registry, not through a fixed port."
        },
        "claudeDiff.autoOpenDiff": {
          "type": "boolean",
          "default": true,
          "description": "Automatically open diff view when Claude edits a file"
        },
        "claudeDiff.showNotifications": {
          "type": "boolean",
          "default": true,
          "description": "Show notifications when files are changed by Claude"
        },
        "claudePlan.autoOpen": {
          "type": "string",
          "enum": [
            "owner",
            "always",
            "never"
          ],
          "enumDescriptions": [
            "Open a plan only in the window whose workspace folder owns the Claude session that wrote it",
            "Open every plan in every window (the behaviour before ownership routing)",
            "Never open plans automatically — use 'Claude: Open Latest Plan' instead"
          ],
          "default": "owner",
          "description": "Which window automatically opens a Claude plan file"
        }
      }
    },
    "keybindings": [
      {
        "command": "claude-cli-companion.openTerminalAndSendContext",
        "key": "ctrl+shift+l",
        "mac": "cmd+shift+l",
        "when": "editorTextFocus"
      },
      {
        "command": "claude-cli-companion.sendContext",
        "key": "ctrl+l",
        "mac": "cmd+l",
        "when": "editorTextFocus"
      },
      {
        "command": "claude-cli-companion.sendFromExplorer",
        "key": "ctrl+l",
        "mac": "cmd+l",
        "when": "explorerViewletFocus"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "vscode:prepublish": "npm run compile",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.3.2",
    "typescript": "^5.3.0"
  }
}
